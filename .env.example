# ─────────────────────────────────────────────────────────────
#  All-I-Do — Environment Variables
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# Database (Neon PostgreSQL)
NEON_DB_URL=postgresql://your_user:your_password@ep-your-db.aws.neon.tech/neondb?sslmode=require

# Authentication
JWT_SECRET=your_jwt_secret

# Backend
PORT=5000
