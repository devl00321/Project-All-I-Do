# ── Neon Postgres (Drizzle ORM) ────────────────────────────
DATABASE_URL=postgresql://neondb_owner:<password>@<host>.neon.tech/neondb?sslmode=require

# Database (Neon PostgreSQL)
NEON_DB_URL=postgresql://your_user:your_password@ep-your-db.aws.neon.tech/neondb?sslmode=require

# Authentication
JWT_SECRET=your_jwt_secret

# ── Redis (ioredis) ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── OTP / SMS ───────────────────────────────────────────────────
ALLOW_CONSOLE_OTP=true
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_msg91_template_id

# ── JWT (RS256) ──────────────────────────────────────────────────
# Generated by: npx tsx scripts/generate-rsa-keys.ts
JWT_PRIVATE_KEY=your_base64_encoded_private_key
JWT_PUBLIC_KEY=your_base64_encoded_public_key

# ── Database (Supabase — legacy, kept for compatibility) ────────
SUPABASE_URL=your_project_url
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_JWT_SECRET=your_jwt_secret
SUPABASE_DB_URL=your_postgres_connection_string

# ── Backend ──────────────────────────────────────────────────────
PORT=5000
